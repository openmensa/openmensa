#!/bin/sh

# Abort script if any step fails. This ensures errors are detected and
# we do not start an only partially working application.
set -e

case "$1" in
sh | bash)
  set -- "$@"
  ;;

rails)
  shift
  set -- bundle exec rails "$@"
  ;;

jobs)
  shift
  set -- bundle exec good_job "$@"
  ;;

server)
  shift

  case "${THRUSTER_ENABLED:-true}" in
  0 | false | no | off)
    set -- bundle exec puma "$@"
    ;;
  *)
    set -- bundle exec thrust puma "$@"
    ;;
  esac
  ;;
esac

set -x
exec "$@"
